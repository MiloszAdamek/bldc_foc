#define SQRT3 1.73205080757f
#define HALF_SQRT3 (SQRT3 / 2.0f)
#define INV_DC_LINK 1.0f  // zakładamy normalizację względem Vdc

void SVPWM_Update(float Valpha, float Vbeta) {
    // Oblicz wektory pomocnicze
    float X = Valpha;
    float Y = (-0.5f * Valpha + HALF_SQRT3 * Vbeta);
    float Z = (-0.5f * Valpha - HALF_SQRT3 * Vbeta);

    float T1 = 0.0f, T2 = 0.0f;
    float Ta = 0.0f, Tb = 0.0f, Tc = 0.0f;

    // Oblicz maksymalne napięcie
    float Uref = fmaxf(fabsf(X), fmaxf(fabsf(Y), fabsf(Z)));
    float Umax = 0.577f; // SVPWM limit w jednostkach 1.0

    // Ogranicz jeśli wychodzi poza sześciokąt
    if (Uref > Umax) {
        float scale = Umax / Uref;
        Valpha *= scale;
        Vbeta *= scale;

        X = Valpha;
        Y = (-0.5f * Valpha + HALF_SQRT3 * Vbeta);
        Z = (-0.5f * Valpha - HALF_SQRT3 * Vbeta);
    }

    // Określenie sektora
    uint8_t sector = 0;
    if (X >= 0) sector |= 0x01;
    if (Y >= 0) sector |= 0x02;
    if (Z >= 0) sector |= 0x04;

    switch (sector) {
        case 3:  // Sector 1
            T1 = Y;
            T2 = X;
            Ta = (T1 + T2) / 2.0f;
            Tb = T2 / 2.0f;
            Tc = 0.0f;
            break;
        case 1:  // Sector 2
            T1 = -Z;
            T2 = -X;
            Ta = T1 / 2.0f;
            Tb = (T1 + T2) / 2.0f;
            Tc = 0.0f;
            break;
        case 5:  // Sector 3
            T1 = Z;
            T2 = Y;
            Ta = 0.0f;
            Tb = (T1 + T2) / 2.0f;
            Tc = T2 / 2.0f;
            break;
        case 4:  // Sector 4
            T1 = -X;
            T2 = -Y;
            Ta = 0.0f;
            Tb = T1 / 2.0f;
            Tc = (T1 + T2) / 2.0f;
            break;
        case 6:  // Sector 5
            T1 = X;
            T2 = Z;
            Ta = T2 / 2.0f;
            Tb = 0.0f;
            Tc = (T1 + T2) / 2.0f;
            break;
        case 2:  // Sector 6
            T1 = -Y;
            T2 = -Z;
            Ta = (T1 + T2) / 2.0f;
            Tb = 0.0f;
            Tc = T1 / 2.0f;
            break;
        default:  // Brak sektora — wektor zerowy
            Ta = Tb = Tc = 0.5f;
            break;
    }

    // Normalizacja do PWM_PERIOD
    uint16_t ta = (uint16_t)(Ta * PWM_PERIOD);
    uint16_t tb = (uint16_t)(Tb * PWM_PERIOD);
    uint16_t tc = (uint16_t)(Tc * PWM_PERIOD);

    // Zabezpieczenie (na wszelki wypadek)
    if (ta > PWM_PERIOD) ta = PWM_PERIOD;
    if (tb > PWM_PERIOD) tb = PWM_PERIOD;
    if (tc > PWM_PERIOD) tc = PWM_PERIOD;

    // Wpisanie do PWM
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, ta);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, tb);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, tc);

    // Debug
    debug_Ta = ta;
    debug_Tb = tb;
    debug_Tc = tc;
}
